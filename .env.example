# Copia este archivo como .env (Copy-Item .env.example .env) y ajusta si hace falta.
# NO pongas credenciales aqui: este archivo se versiona; .env esta en .gitignore.

# --- Red ---
# Host que los brokers anuncian a clientes EXTERNOS (puertos 9092/9093).
# Local: localhost. En AWS: la IP publica de la EC2.
PUBLIC_HOST=localhost

# --- Topicos (los crea el servicio kafka-init al levantar) ---
RAW_TOPIC=ventas-raw
AGG_TOPIC=ventas-agregadas
DLQ_TOPIC=ventas-raw-dlq
# 3 particiones: paralelismo de hasta 3 tareas de Streams y reparto de lideres entre 2 brokers.
TOPIC_PARTITIONS=3
# RF=2 es el maximo posible con 2 brokers (RF=3 es imposible).
TOPIC_REPLICATION_FACTOR=2
# 1 = prioriza disponibilidad (se produce con un broker caido); 2 = prioriza durabilidad (acks=all se bloquea).
MIN_INSYNC_REPLICAS=1
# Retencion: 7 dias para datos operativos, 30 dias para la DLQ (tiempo para investigar y reprocesar).
RAW_RETENTION_MS=604800000
AGG_RETENTION_MS=604800000
DLQ_RETENTION_MS=2592000000

# --- Kafka Streams ---
# application.id = nombre del consumer group y prefijo de los topicos internos.
GROUP_ID=ventas-aggregator
# Ventana tumbling por eventTime y periodo de gracia para eventos tardios (segundos).
# Gracia 120 s: cubre el desfase del productor Y el reordenamiento al reprocesar atraso tras una caida
# del consumidor de hasta ~2 min (ver evidencia 10a). Costo: cada ventana se publica 3 min despues de abrir.
WINDOW_SECONDS=60
WINDOW_GRACE_SECONDS=120
# Cuanto tiempo se recuerda un eventId para detectar duplicados (>= ventana + gracia = 3 min).
DEDUP_RETENTION_MINUTES=10
COMMIT_INTERVAL_MS=1000

# --- Productor de ventas ---
PRODUCE_INTERVAL=1.0
PRODUCER_MAX_EVENTS=0
CUSTOMER_POOL=200
